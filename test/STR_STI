0x2207 // 0x3000: LD R1, #7      (R1 = 0xAAAA)
0x2407 // 0x3001: LD R2, #7      (R2 = 0xBBBB)
0x2607 // 0x3002: LD R3, #7      (R3 = 0x300C [STRのベースアドレス])
0x72C2 // 0x3003: STR R1, R3, #2 (m[R3 + 2] つまり m[0x300E] に 0xAAAA を書き込む)
0xB406 // 0x3004: STI R2, #6     (m[0x300B] の値(0x300F)をアドレスとし、そこに 0xBBBB を書き込む)
0x2808 // 0x3005: LD R4, #8      (m[0x300E] から R4 に読み込む。STRの成功確認！)
0x2A08 // 0x3006: LD R5, #8      (m[0x300F] から R5 に読み込む。STIの成功確認！)
0xF025 // 0x3007: TRAP 0x25      (HALT)
0xAAAA // 0x3008: [データ] 0xAAAA
0xBBBB // 0x3009: [データ] 0xBBBB
0x300C // 0x300A: [データ] STR用のベースアドレス
0x300F // 0x300B: [データ] STI用のポインタ先アドレス
0x0000 // 0x300C: 空き
0x0000 // 0x300D: 空き
0x0000 // 0x300E: [STRの書き込み先]
0x0000 // 0x300F: [STIの書き込み先]
